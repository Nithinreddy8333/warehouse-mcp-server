# All optional. Defaults work from the repository root after `make sample`.
WAREHOUSE_PATH=warehouse/warehouse.duckdb
POLICY_PATH=config/policy.yaml
CHECKS_PATH=config/checks.yaml
AUDIT_LOG=logs/audit.jsonl

# The role this server process runs as. Fixed at start; clients cannot change it.
MCP_ROLE=analyst
# Salt for the 'hash' mask. Unset = random per start (hashes change on restart).
MASK_SALT=
